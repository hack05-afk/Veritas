# Copy to .env and fill in. .env is never committed.

# Language model used for extraction and explanation only. It never computes a
# number and never sees a raw record. Set to fake to answer from fixtures.
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-id-under-20b
LLM_API_KEY=replace-me

# Sarvam is used for speech to text, translation and text to speech only.
SARVAM_API_KEY=replace-me

QUERY_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DUCKDB_MEMORY_LIMIT=1GB
DATA_DIR=services/query/data
