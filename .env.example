# Copy to .env and fill in. .env is never committed.

# Language model used for extraction and explanation only. It never computes a
# number and never sees a raw record. Leave LLM_PROVIDER=fake and the keys empty
# to run entirely from fixtures, with no network calls.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Sarvam is used for speech to text, translation and text to speech only.
# Leave SARVAM_PROVIDER=fake and the key empty to use the fixture clips.
SARVAM_PROVIDER=fake
SARVAM_API_KEY=

# Encryption at rest for account_number and utr_number. 32 bytes, base64.
# Generate one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# The loader and the query service refuse to start without it. Set
# VERITAS_ENCRYPTION=off to run on plaintext for local development; the service
# then warns on every start.
VERITAS_ENCRYPTION_KEY=
VERITAS_ENCRYPTION=

QUERY_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DUCKDB_MEMORY_LIMIT=1GB

# The dataset the loader wrote. Relative paths are read from the repository root.
DATA_DIR=services/query/data/test_100k
